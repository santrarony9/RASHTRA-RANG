\u092a \u092e\u0947\u0902 \u091f\u0940\u092e \u0907\u0902\u0921\u093f\u092f\u093e \u0915\u0940 \u090f\u0915 \u0911\u091f\u094b\u0917\u094d\u0930\u093e\u092b \u0935\u093e\u0932\u0940 \u091c\u0930\u094d\u0938\u0940 \u092d\u0947\u0902\u091f \u0915\u0940\u0964 \u092e\u0941\u0916\u094d\u092f\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u090f\u0915\u094d\u0938 (\u091f\u094d\u0935\u093f\u091f\u0930) \u092a\u0930 \u090f\u0915 \u092a\u094b\u0938\u094d\u091f \u092e\u0947\u0902 \u0907\u0938 \u0909\u092a\u0939\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u0906\u092d\u093e\u0930 \u091c\u0924\u093e\u092f\u093e \u0914\u0930 \u0915\u0939\u093e \u0915\u093f \u092f\u0939 \u092a\u0932 \u0916\u0947\u0932 \u0915\u0940 \u0932\u094b\u0917\u094b\u0902 \u0915\u094b \u090f\u0915\u091c\u0941\u091f \u0915\u0930\u0928\u0947 \u0915\u0940 \u0936\u0915\u094d\u0924\u093f \u0915\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948\u0964 <br \/><br \/>\u092e\u0941\u0916\u094d\u092f\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u092a\u094b\u0938\u094d\u091f \u092e\u0947\u0902 \u0932\u093f\u0916\u093e \u0915\u093f \u0927\u0928\u0924\u0947\u0930\u0938 \u0914\u0930 \u0915\u093e\u0932\u0940 \u092a\u0942\u091c\u093e \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u0947 \u0909\u0924\u094d\u0938\u0935\u094b\u0902 \u0915\u0947 \u0936\u0941\u092d \u0905\u0935\u0938\u0930 \u092a\u0930 \u0915\u094b\u0932\u0915\u093e\u0924\u093e \u092e\u0947\u0902 \u090f\u0915 \u092c\u0939\u0941\u0924 \u0939\u0940 \u0936\u093e\u0928\u0926\u093e\u0930 \u0914\u0930 \u091c\u0940\u0935\u0902\u0924 \u0936\u093e\u092e \u0930\u0939\u0940\u0964 \u0926\u093f\u0917\u094d\u0917\u091c \u092a\u0942\u0930\u094d\u0935 \u0915\u094d\u0930\u093f\u0915\u0947\u091f\u0930 \u0914\u0930 \u0938\u093e\u0902\u0938\u0926 \u0939\u0930\u092d\u091c\u0928 \u0938\u093f\u0902\u0939 \u0938\u0947 \u092e\u093f\u0932\u0915\u0930 \u092c\u0939\u0941\u0924 \u0916\u0941\u0936\u0940 \u0939\u0941\u0908\u0964 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 