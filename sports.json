u0905\u092a\u0928\u0947 \u0921\u0947\u0922\u093c \u092e\u0939\u0940\u0928\u0947 \u0932\u0902\u092c\u0947 \u0926\u094c\u0930\u0947 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u092a\u093e\u0902\u091a \u092e\u0948\u091a\u094b\u0902 \u0915\u0940 T20I \u0938\u0940\u0930\u0940\u091c\u093c \u0938\u0947 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948, \u091c\u094b \u0915\u093f 22 \u0905\u0915\u094d\u0924\u0942\u092c\u0930 \u0938\u0947 \u0915\u094d\u0930\u093e\u0907\u0938\u094d\u091f\u091a\u0930\u094d\u091a \u092e\u0947\u0902 \u0936\u0941\u0930\u0942 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948\u0964  \u0928\u094d\u092f\u0942\u091c\u093c\u0940\u0932\u0948\u0902\u0921 \u0915\u0947 \u0905\u092a\u0928\u0947 \u0921\u0947\u0922\u093c \u092e\u0939\u0940\u0928\u0947 \u0932\u0902\u092c\u0947 \u0926\u094c\u0930\u0947 \u0915\u093e \u0906\u0917\u093e\u091c\u093c \u092d\u093e\u0930\u0924 \u092a\u093e\u0902\u091a T20I \u092e\u0948\u091a\u094b\u0902 \u0915\u0940 \u0938\u0940\u0930\u0940\u091c\u093c \u0938\u0947 \u0915\u0930\u0947\u0917\u093e\u0964 \u0935\u0947\u0938\u094d\u091f\u0907\u0902\u0921\u0940\u091c\u093c \u0915\u0947 \u0916\u093c\u093f\u0932\u093e\u092b\u093c \u0938\u0940\u0930\u0940\u091c\u093c 2-2 \u0938\u0947 \u092c\u0930\u093e\u092c\u0930 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0935\u0947 \u091a\u093e\u0939\u0947\u0902\u0917\u0947 \u0915\u093f \u0907\u0938 \u0938\u0940\u0930\u0940\u091c\u093c \u092e\u0947\u0902 \u0935\u0947 \u092b\u093f\u0930 \u0938\u0947 \u091c\u0940\u0924 \u0915\u0940 \u0930\u093e\u0939 \u092a\u0930 \u0935\u093e\u092a\u0938\u0940 \u0915\u0930\u0947\u0902\u0964 \u092a\u093e\u0902\u091a T20I \u0915\u0947 \u092c\u093e\u0926 \u092d\u093e\u0930\u0924 \u0915\u094b \u0928\u094d\u092f\u0942\u091c\u093c\u0940\u0932\u0948\u0902\u0921 \u0915\u0947 \u0916\u093c\u093f\u0932\u093e\u092b\u093c \u092a\u093e\u0902\u091a \u0935\u0928\u0921\u0947 \u0914\u0930 \u0926\u094b \u091f\u0947\u0938\u094d\u091f \u092e\u0948\u091a \u092d\u0940 \u0916\u0947\u0932\u0928\u0947 \u0939\u0948\u0902\u0964<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u092f\u0947 T20I \u092e\u0948\u091a \u092d\u093e\u0930\u0924\u0940\u092f \u0938\u092e\u092f\u093e\u0928\u0941\u0938\u093e\u0930 \u0926\u094b\u092a\u0939\u0930 12.30 \u092c\u091c\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b\u0902\u0917\u0947, \u091c\u092c\u0915\u093f \u0935\u0928\u0921\u0947 \u092e\u0941\u0915\u093c\u093e\u092c\u0932\u0947 \u0938\u0941\u092c\u0939 7.30 \u092c\u091c\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b\u0902\u0917\u0947\u0964 \u091f\u0947\u0938\u094d\u091f \u092e\u0948\u091a \u0938\u0941\u092c\u0939 3.30 \u092c\u091c\u0947 \u0936\u0941\u0930\u0942 \u0939\u094b\u0902\u0917\u0947\u0964<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>T20I \u0938\u0940\u0930\u0940\u091c\u093c \u0915\u0947 \u0932\u093f\u090f \u092d\u093e\u0930\u0924\u0940\u092f \u091f\u0940\u092e<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u0936\u094d\u0930\u0947\u092f\u0938 \u0905\u092f\u094d\u092f\u0930 (\u0915\u092a\u094d\u0924\u093e\u0928), \u0905\u092d\u093f\u0937\u0947\u0915 \u0936\u0930\u094d\u092e\u093e, \u0938\u0902\u091c\u0942 \u0938\u0948\u092e\u0938\u0928 (\u0935\u093f\u0915\u0947\u091f\u0915\u0940\u092a\u0930), \u0935\u0948\u092d\u0935 \u0938\u0942\u0930\u094d\u092f\u0935\u0902\u0936\u0940, \u0907\u0936\u093e\u0928 \u0915\u093f\u0936\u0928 (\u0935\u093f\u0915\u0947\u091f\u0915\u0940\u092a\u0930), \u0924\u093f\u0932\u0915 \u0935\u0930\u094d\u092e\u093e (\u0909\u092a-\u0915\u092a\u094d\u0924\u093e\u0928), \u0905\u0915\u094d\u0937\u0930 \u092a\u091f\u0947\u0932, \u0936\u093f\u0935\u092e \u0926\u0941\u092c\u0947, \u0928\u0940\u0924\u0940\u0936 \u0915\u0941\u092e\u093e\u0930 \u0930\u0947\u0921\u094d\u0921\u0940, \u0928\u092e\u0928 \u0927\u0940\u0930, \u092a\u094d\u0930\u093f\u0902\u0938 \u092f\u093e\u0926\u0935, \u092e\u092f\u0902\u0915 \u092f\u093e\u0926\u0935, \u0905\u0930\u094d\u0936\u0926\u0940\u092a \u0938\u093f\u0902\u0939, \u092d\u0941\u0935\u0928\u0947\u0936\u094d\u0935\u0930 \u0915\u0941\u092e\u093e\u0930, \u0935\u0930\u0941\u0923 \u091a\u0915\u094d\u0930\u0935\u0930\u094d\u0924\u0940, \u0915\u0941\u0932\u0926\u0940\u092a \u092f\u093e\u0926\u0935\u0964<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>\u092a\u0939\u0932\u0947 \u0924\u0940\u0928 \u0935\u0928\u0921\u0947 \u0915\u0947 \u0932\u093f\u090f \u092d\u093e\u0930\u0924\u0940\u092f \u091f\u0940\u092e<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u0936\u0941\u092d\u092e\u0928 \u0917\u093f\u0932 (\u0915\u092a\u094d\u0924\u093e\u0928), \u0930\u094b\u0939\u093f\u0924 \u0936\u0930\u094d\u092e\u093e, \u0935\u093f\u0930\u093e\u091f \u0915\u094b\u0939\u0932\u0940, \u0936\u094d\u0930\u0947\u092f\u0938 \u0905\u092f\u094d\u092f\u0930 (\u0909\u092a\u0915\u092a\u094d\u0924\u093e\u0928), \u0915\u0947\u090f\u0932 \u0930\u093e\u0939\u0941\u0932 (\u0935\u093f\u0915\u0947\u091f\u0915\u0940\u092a\u0930), \u0928\u0940\u0924\u0940\u0936 \u0915\u0941\u092e\u093e\u0930 \u0930\u0947\u0921\u094d\u0921\u0940, \u0905\u0915\u094d\u0937\u0930 \u092a\u091f\u0947\u0932, \u0928\u092e\u0928 \u0927\u0940\u0930, \u0905\u0902\u0936\u0941\u0932 \u0915\u092e\u094d\u092c\u094b\u091c, \u0917\u0941\u0930\u0928\u0942\u0930 \u092c\u0930\u093e\u0921\u093c, \u090b\u0924\u0941\u0930\u093e\u091c \u0917\u093e\u092f\u0915\u0935\u093e\u0921\u093c, \u0905\u0930\u094d\u0936\u0926\u0940\u092a \u0938\u093f\u0902\u0939, \u0907\u0936\u093e\u0928 \u0915\u093f\u0936\u0928 (\u0935\u093f\u0915\u0947\u091f\u0915\u0940\u092a\u0930), \u092e\u094b\u0939\u092e\u094d\u092e\u0926 \u0938\u093f\u0930\u093e\u091c, \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0915\u0943\u0937\u094d\u0923\u093e \u0914\u0930 \u0915\u0941\u0932\u0926\u0940\u092a \u092f\u093e\u0926\u0935\u0964<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>\u091a\u094c\u0925\u0947 \u0914\u0930 \u092a\u093e\u0902\u091a\u0935\u0947\u0902 \u0935\u0928\u0921\u0947 \u0915\u0947 \u0932\u093f\u090f \u092d\u093e\u0930\u0924\u0940\u092f \u091f\u0940\u092e<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u0936\u094d\u0930\u0947\u092f\u0938 \u0905\u092f\u094d\u092f\u0930 (\u0915\u092a\u094d\u0924\u093e\u0928), \u0930\u094b\u0939\u093f\u0924 \u0936\u0930\u094d\u092e\u093e, \u0935\u093f\u0930\u093e\u091f \u0915\u094b\u0939\u0932\u0940, \u0924\u093f\u0932\u0915 \u0935\u0930\u094d\u092e\u093e, \u0907\u0936\u093e\u0928 \u0915\u093f\u0936\u0928 (\u0935\u093f\u0915\u0947\u091f\u0915\u0940\u092a\u0930 \u0914\u0930 \u0909\u092a\u0915\u092a\u094d\u0924\u093e\u0928), \u0928\u0940\u0924\u0940\u0936 \u0915\u0941\u092e\u093e\u0930 \u0930\u0947\u0921\u094d\u0921\u0940, \u0905\u0915\u094d\u0937\u0930 \u092a\u091f\u0947\u0932, \u0928\u092e\u0928 \u0927\u0940\u0930, \u0906\u0915\u093c\u093f\u092c \u0928\u092c\u0940, \u0917\u0941\u0930\u0928\u0942\u0930 \u092c\u0930\u093e\u0921\u093c, \u090b\u0924\u0941\u0930\u093e\u091c \u0917\u093e\u092f\u0915\u0935\u093e\u0921\u093c, \u0905\u0930\u094d\u0936\u0926\u0940\u092a \u0938\u093f\u0902\u0939, \u0915\u0941\u092e\u093e\u0930 \u0915\u0941\u0936\u093e\u0917\u094d\u0930 (\u0935\u093f\u0915\u0947\u091f\u0915\u0940\u092a\u0930), \u092e\u094b\u0939\u092e\u094d\u092e\u0926 \u0938\u093f\u0930\u093e\u091c, \u092f\u0936 \u0920\u093e\u0915\u0941\u0930 \u0914\u0930 \u0915\u0941\u0932\u0926\u0940\u092a \u092f\u093e\u0926\u0935\u0964<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>\u091f\u0947\u0938\u094d\u091f \u0938\u0940\u0930\u0940\u091c\u093c \u0915\u0947 \u0932\u093f\u090f \u092d\u093e\u0930\u0924\u0940\u092f \u091f\u0940\u092e<\/strong><\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u0936\u0941\u092d\u092e\u0928 \u0917\u093f\u0932 (\u0915\u092a\u094d\u0924\u093e\u0928), \u092f\u0936\u0938\u094d\u0935\u0940 \u091c\u093e\u092f\u0938\u0935\u093e\u0932, \u0915\u0947\u090f\u0932 \u0930\u093e\u0939\u0941\u0932 (\u0909\u092a\u0915\u092a\u094d\u0924\u093e\u0928), \u0926\u0947\u0935\u0926\u0924\u094d\u0924 \u092a\u0921\u093c\u093f\u0915\u094d\u0915\u0932, \u090b\u0937\u092d \u092a\u0902\u0924 (\u0935\u093f\u0915\u0947\u091f\u0915\u0940\u092a\u0930), \u0927\u094d\u0930\u0941\u0935 \u091c\u0941\u0930\u0947\u0932 (\u0935\u093f\u0915\u0947\u091f\u0915\u0940\u092a\u0930), \u0930\u0935\u0940\u0902\u0926\u094d\u0930 \u091c\u093e\u0921\u0947\u091c\u093e, \u0905\u0902\u0936\u0941\u0932 \u0915\u092e\u094d\u092c\u094b\u091c, \u091c\u0938\u092a\u094d\u0930\u0940\u0924 \u092c\u0941\u092e\u0930\u093e\u0939, \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0915\u0943\u0937\u094d\u0923\u093e, \u0906\u0915\u093e\u0936 \u0926\u0940\u092a, \u0938\u093e\u0908 \u0938\u0941\u0926\u0930\u094d\u0936\u0928, \u0928\u0940\u0924\u0940\u0936 \u0915\u0941\u092e\u093e\u0930 \u0930\u0947\u0921\u094d\u0921\u0940, \u0935\u0949\u0936\u093f\u0902\u0917\u091f\u0928 \u0938\u0941\u0902\u0926\u0930, \u0915\u0941\u0932\u0926\u0940\u092a \u092f\u093e\u0926\u0935 \u0914\u0930 \u092e\u094b\u0939\u092e\u094d\u092e\u0926 \u0938\u093f\u0930\u093e\u091c\u0964<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0915\u0943\u0937\u094d\u0923\u093e \u0914\u0930 \u090b\u0937\u092d \u092a\u0902\u0924 \u0915\u093e \u091a\u092f\u0928 \u092b\u093c\u093f\u091f\u0928\u0947\u0938 \u0915\u094d\u0932\u0940\u092f\u0930\u0947\u0902\u0938 \u092a\u0930 \u0928\u093f\u0930\u094d\u092d\u0930 \u0915\u0930\u0947\u0917\u093e\u0964<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u092d\u093e\u0930\u0924 \u0928\u094d\u092f\u0942\u091c\u093c\u0940\u0932\u0948\u0902\u0921 \u0915\u0947 \u0905\u092a\u0928\u0947 \u0921\u0947\u0922\u093c \u092e\u0939\u0940\u0928\u0947 \u0932\u0902\u092c\u0947 \u0926\u094c\u0930\u0947 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u092a\u093e\u0902\u091a \u092e\u0948\u091a\u094b\u0902 \u0915\u0940 T20I \u0938\u0940\u0930\u0940\u091c\u093c \u0938\u0947 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948, \u091c\u094b \u0915\u093f 22 \u0905\u0915\u094d\u0924\u0942\u092c\u0930 \u0938\u0947 \u0915\u094d\u0930\u093e\u0907\u0938\u094d\u091f\u091a\u0930\u094d\u091a \u092e\u0947\u0902 \u0936\u0941\u0930\u0942 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948\u0964 \u0928\u094d\u092f\u0942\u091c\u093c\u0940\u0932\u0948\u0902\u0921 \u0915\u0947 \u0905\u092a\u0928\u0947 \u0921\u0947\u0922\u093c \u092e\u0939\u0940\u0928\u0947 \u0932\u0902\u092c\u0947 \u0926\u094c\u0930\u0947 \u0915\u093e \u0906\u0917\u093e\u091c\u093c \u092d\u093e\u0930\u0924 \u092a\u093e\u0902\u091a T20I \u092e\u0948\u091a\u094b\u0902 \u0915\u0940 \u0938\u0940\u0930\u0940\u091c\u093c \u0938\u0947 \u0915\u0930\u0947\u0917\u093e\u0964 \u0935\u0947\u0938\u094d\u091f\u0907\u0902\u0921\u0940\u091c\u093c \u0915\u0947 \u0916\u093c\u093f\u0932\u093e\u092b\u093c \u0938\u0940\u0930\u0940\u091c\u093c 2-2 \u0938\u0947 \u092c\u0930\u093e\u092c\u0930 \u0939\u094b\u0928\u0947 [&hellip;]<\/p>\n","protected":false},"author":2,"featured_media":3774,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"googlesitekit_rrm_CAow6JXiCw:productID":"","footnotes":""},"categories":[91],"tags":[184,273,332,386],"class_list":["post-3769","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-91","tag-criket-2","tag-hindi_india","tag-hindinews","tag-indianteam"],"_links":{"self":[{"href":"https:\/\/www.rashtrarang.com\/index.php?rest_route=\/wp\/v2\/posts\/3769","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.rashtrarang.com\/index.php?rest_route=\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/www.rashtrarang.com\/index.php?rest_route=\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/www.rashtrarang.com\/index.php?rest_route=\/wp\/v2\/users\/2"}],"replies":[{"embeddable":true,"href":"https:\/\/www.rashtrarang.com\/index.php?rest_route=%2Fwp%2Fv2%2Fcomments&post=3769"}],"version-history":[{"count":0,"href":"https:\/\/www.rashtrarang.com\/index.php?rest_route=\/wp\/v2\/posts\/3769\/revisions"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/www.rashtrarang.com\/index.php?rest_route=\/wp\/v2\/media\/3774"}],"wp:attachment":[{"href":"https:\/\/www.rashtrarang.com\/index.php?rest_route=%2Fwp%2Fv2%2Fmedia&parent=3769"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/www.rashtrarang.com\/index.php?rest_route=%2Fwp%2Fv2%2Fcategories&post=3769"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/www.rashtrarang.com\/index.php?rest_route=%2Fwp%2Fv2%2Ftags&post=3769"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":3715,"date":"2026-10-20T00:41:30","date_gmt":"2026-10-19T19:11:30","guid":{"rendered":"https:\/\/www.rashtrarang.com\/?p=3715"},"modified":"2026-10-20T00:41:37","modified_gmt":"2026-10-19T19:11:37","slug":"%e0%a4%8f%e0%a4%95%e0%a4%a4%e0%a4%be-%e0%a4%ac%e0%a4%bf%e0%a4%b6%e0%a5%8d%e0%a4%a8%e0%a5%8b%e0%a4%88-%e0%a4%a8%e0%a5%87-%e0%a4%b5%e0%a4%bf%e0%a4%b6%e0%a5%8d%e0%a4%b5-%e0%a4%ae%e0%a4%be%e0%a4%b8","status":"publish","type":"post","link":"https:\/\/www.rashtrarang.com\/?p=3715","title":{"rendered":"\u090f\u0915\u0924\u093e \u092c\u093f\u0936\u094d\u0928\u094b\u0908 \u0928\u0947 \u0935\u093f\u0936\u094d\u0935 \u092e\u093e\u0938\u094d\u091f\u0930\u094d\u0938 \u092a\u093e\u0935\u0930\u0932\u093f\u092b\u094d\u091f\u093f\u0902\u0917 \u091a\u0948\u0902\u092a\u093f\u092f\u0928\u0936\u093f\u092a \u092e\u0947\u0902 \u091c\u0940\u0924\u0947 \u0924\u0940\u0928 \u0938\u094d\u0935\u0930\u094d\u0923 \u092a\u0926\u0915"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">\u0928\u092f\u0940 \u0926\u093f\u0932\u094d\u0932\u0940 : \u092d\u093e\u0930\u0924 \u0915\u0940 \u090f\u0915\u0924\u093e \u092c\u093f\u0936\u094d\u0928\u094b\u0908 \u0928\u0947 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u092e\u0947\u0902 \u0906\u092f\u094b\u091c\u093f\u0924 \u0935\u093f\u0936\u094d\u0935 \u092e\u093e\u0938\u094d\u091f\u0930\u094d\u0938 \u0915\u094d\u0932\u093e\u0938\u093f\u0915 \u092a\u093e\u0935\u0930\u0932\u093f\u092b\u094d\u091f\u093f\u0902\u0917 \u091a\u0948\u0902\u092a\u093f\u092f\u0928\u0936\u093f\u092a \u092e\u0947\u0902 \u0924\u0940\u0928 \u0938\u094d\u0935\u0930\u094d\u0923 \u092a\u0926\u0915 \u091c\u0940\u0924\u0915\u0930 \u0907\u0924\u093f\u0939\u093e\u0938 \u0930\u091a \u0926\u093f\u092f\u093e\u0964<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><br>\u092f\u0939\u093e\u0902 \u091c\u093e\u0930\u0940 \u0935\u093f\u091c\u094d\u091e\u092a\u094d\u0924\u093f \u0915\u0947 \u092e\u0941\u0924\u093e\u092c\u093f\u0915, \u092f\u0939 \u092a\u0939\u0932\u093e \u092e\u094c\u0915\u093e \u0939\u0948 \u091c\u092c \u0907\u0938 \u091a\u0948\u0902\u092a\u093f\u092f\u0928\u0936\u093f\u092a \u0915\u0947 \u2018\u092e\u093e\u0938\u094d\u091f\u0930\u094d\u0938-2\u2019 \u0935\u0930\u094d\u0917 \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092d\u093e\u0930\u0924\u0940\u092f \u092e\u0939\u093f\u0932\u093e \u092a\u093e\u0935\u0930\u0932\u093f\u092b\u094d\u091f\u0930 \u0928\u0947 \u0938\u094d\u0935\u0930\u094d\u0923 \u092a\u0926\u0915 \u091c\u0940\u0924\u093e \u0939\u0948\u0964 \u092d\u093e\u0930\u0924\u0940\u092f \u0930\u093e\u091c\u0938\u094d\u0935 \u0938\u0947\u0935\u093e (\u0906\u0908\u0906\u0930\u090f\u0938) \u0915\u0940 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u090f\u0915\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0938\u0930\u0915\u093e\u0930\u0940 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0916\u0947\u0932 \u092e\u0947\u0902 \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0939\u0928\u093e \u0906\u0938\u093e\u0928 \u0928\u0939\u0940\u0902 \u0930\u0939\u093e\u0964 \u0907\u0938\u0915\u0947 \u092c\u093e\u0935\u091c\u0942\u0926 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0905\u092a\u0928\u0940 \u092e\u0947\u0939\u0928\u0924 \u0914\u0930 \u0926\u0943\u0922\u093c \u0938\u0902\u0915\u0932\u094d\u092a \u0938\u0947 \u0905\u0902\u0924\u0930\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092e\u0902\u091a \u092a\u0930 \u092f\u0939 \u0909\u092a\u0932\u092c\u094d\u0927\u093f \u0939\u093e\u0938\u093f\u0932 \u0915\u0940\u0964<\/p>\n\n\n\n<p class=\"wp-block-paragraph\"><br>\u090f\u0915\u0924\u093e \u0915\u0947 \u0915\u094b\u091a \u0938\u0941\u0928\u0940\u0932 \u0915\u0941\u092e\u093e\u0930 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u090f\u0915\u0924\u093e \u0915\u094b \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0914\u0930 \u092a\u0930\u093f\u0923\u093e\u092e-\u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0926\u093f\u092f\u093e \u0925\u093e\u0964 \u092a\u094d\u0930\u0924\u093f\u092f\u094b\u0917\u093f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0938\u0941\u0928\u0940\u0932 \u0915\u0941\u092e\u093e\u0930 \u0915\u094b \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u0915\u093e \u0935\u0940\u091c\u093e \u0928\u0939\u0940\u0902 \u092e\u093f\u0932 \u0938\u0915\u093e\u0964 \u0907\u0938\u0915\u0947 \u092c\u093e\u0935\u091c\u0942\u0926 \u090f\u0915\u0924\u093e \u0928\u0947 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932 \u0914\u0930 \u091f\u0940\u092e \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u092c\u093f\u0928\u0941 \u0907\u092c\u094d\u0930\u093e\u0939\u093f\u092e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0909\u0928\u0915\u0947 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0930\u0923\u0928\u0940\u0924\u093f \u092a\u0930 \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0905\u092e\u0932 \u0915\u093f\u092f\u093e \u0914\u0930 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0938\u092b\u0932\u0924\u093e \u0939\u093e\u0938\u093f\u0932 \u0915\u0940\u0964 \u090f\u0915\u0924\u093e \u0928\u0947 \u0915\u0941\u0932 362.5 \u0915\u093f\u0932\u094b\u0917\u094d\u0930\u093e\u092e \u0935\u091c\u0928 \u0909\u0920\u093e\u0915\u0930 \u091c\u093e\u092a\u093e\u0928 \u0914\u0930 \u0915\u0928\u093e\u0921\u093e \u0915\u0940 \u0916\u093f\u0932\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u0915\u094b \u092a\u0940\u091b\u0947 \u091b\u094b\u0921\u093c\u093e \u0914\u0930 \u0938\u094d\u0935\u0930\u094d\u0923 \u092a\u0926\u0915 \u0905\u092a\u0928\u0947 \u0928\u093e\u092e \u0915\u093f\u092f\u093e\u0964<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u0928\u092f\u0940 \u0926\u093f\u0932\u094d\u0932\u0940 : \u092d\u093e\u0930\u0924 \u0915\u0940 \u090f\u0915\u0924\u093e \u092c\u093f\u0936\u094d\u0928\u094b\u0908 \u0928\u0947 \u0905\u092e\u0947\u0930\u093f\u0915\u093e \u092e\u0947\u0902 \u0906\u092f\u094b\u091c\u093f\u0924 \u0935\u093f\u0936\u094d\u0935 \u092e\u093e\u0938\u094d\u091f\u0930\u094d\u0938 \u0915\u094d\u0932\u093e\u0938\u093f\u0915 \u092a\u093e\u0935\u0930\u0932\u093f\u092b\u094d\u091f\u093f\u0902\u0917 \u091a\u0948\u0902\u092a\u093f\u092f\u0928\u0936\u093f\u092a \u092e\u0947\u0902 \u0924\u0940\u0928 \u0938\u094d\u0935\u0930\u094d\u0923 \u092a\u0926\u0915 \u091c\u0940\u0924\u0915\u0930 \u0907\u0924\u093f\u0939\u093e\u0938 \u0930\u091a \u0926\u093f\u092f\u093e\u0964 \u092f\u0939\u093e\u0902 \u091c\u093e\u0930\u0940 \u0935\u093f\u091c\u094d\u091e\u092a\u094d\u0924\u093f \u0915\u0947 \u092e\u0941\u0924\u093e\u092c\u093f\u0915, \u092f\u0939 \u092a\u0939\u0932\u093e \u092e\u094c\u0915\u093e \u0939\u0948 \u091c\u092c \u0907\u0938 \u091a\u0948\u0902\u092a\u093f\u092f\u0928\u0936\u093f\u092a \u0915\u0947 \u2018\u092e\u093e\u0938\u094d\u091f\u0930\u094d\u0938-2\u2019 \u0935\u0930\u094d\u0917 \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092d\u093e\u0930\u0924\u0940\u092f \u092e\u0939\u093f\u0932\u093e \u092a\u093e\u0935\u0930\u0932\u093f\u092b\u094d\u091f\u0930 \u0928\u0947 \u0938\u094d\u0935\u0930\u094d\u0923 \u092a\u0926\u0915 \u091c\u0940\u0924\u093e \u0939\u0948\u0964 \u092d\u093e\u0930\u0924\u0940\u092f \u0930\u093e\u091c\u0938\u094d\u0935 \u0938\u0947\u0935\u093e (\u0906\u0908\u0906\u0930\u090f\u0938) \u0915\u0940 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 [&hellip;]<\/p>\n","protected":false},"author":2,"featured_m